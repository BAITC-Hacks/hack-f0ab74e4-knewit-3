# Нужен только для LLM-режима агента; без ключа: run-agent --no-llm

# ---- OpenAI — основной вариант (ADR-010) ----
OPENAI_API_KEY=sk-proj-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
# Доступные по вашему ключу модели: python -m src.cli list-models

# ---- Альтернатива: NVIDIA NIM (OpenAI-совместимый протокол) ----
# LLM_API_KEY=nvapi-...
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct

# ---- Альтернатива: Claude ----
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# Приоритет: LLM_BACKEND > ключ OpenAI > ANTHROPIC_API_KEY. Ключ OpenAI выигрывает
# намеренно: ANTHROPIC_API_KEY часто висит в окружении от сторонних инструментов.
# LLM_BACKEND=openai
