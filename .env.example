# Ключи нужны только для LLM-режима агента (run-agent без --no-llm).
# Достаточно ОДНОГО из вариантов; без ключей используйте --no-llm.

# Вариант 1: Claude (приоритетный)
ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# Вариант 2: OpenAI-совместимый эндпоинт (OpenAI или NVIDIA NIM)
# LLM_API_KEY=nvapi-...
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct
