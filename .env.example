# Скопируйте в .env и заполните. Нужно только для LLM-режима агента
# (run-agent без --no-llm). Без ключа работает --no-llm — тот же конвейер
# детерминированным циклом. Файл .env в .gitignore, в репозиторий не попадает.

# ---- OpenAI (ChatGPT API) — основной вариант ----
LLM_API_KEY=sk-proj-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Какие модели реально доступны по вашему ключу:
#   python -m src.cli list-models
# Требования к модели: надёжный tool calling и вменяемый русский.
# Рассуждающие модели (o-серия) для этой задачи избыточны и дороже —
# агент оркеструет тулы, а не решает олимпиадные задачи.

# ---- Альтернатива: NVIDIA NIM (тот же OpenAI-совместимый протокол) ----
# LLM_API_KEY=nvapi-...
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct

# ---- Альтернатива: Claude ----
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# Приоритет бэкендов: LLM_BACKEND > LLM_API_KEY > ANTHROPIC_API_KEY.
# LLM_API_KEY выигрывает намеренно: ANTHROPIC_API_KEY часто уже висит в окружении
# от сторонних инструментов и иначе молча перебивал бы настройку из этого файла.
# Принудительно выбрать бэкенд: LLM_BACKEND=openai | anthropic | none
# LLM_BACKEND=openai
